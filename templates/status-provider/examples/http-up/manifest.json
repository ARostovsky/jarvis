{
  "schema": 1,
  "name": "http-up",
  "kind": "jobs",
  "description": "Example: is a host answering over HTTP (2xx/3xx = done, else failed)",
  "command": ["sh", "http_up.sh"],
  "args": ["{ids}"],
  "pollS": 60,
  "timeoutS": 30,
  "idPattern": "^[A-Za-z0-9][A-Za-z0-9.:-]{0,100}$",
  "maxIds": 20,
  "env": { "pass": [], "set": { "HTTP_SCHEME": "https" } },
  "needs": ["network access to the hosts"],
  "notify": "any"
}
